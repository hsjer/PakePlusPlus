# cloud function prefix
VITE_GITHUB_TOKEN_PREFIX=https://api.github.com
# cloud function token
VITE_CLOUD_FUNCTION_TOKEN=https://api.github.com
# github domain (API 地址,关键:决定 axios baseURL)
VITE_GITHUB_DOMAIN=https://api.github.com
# pay domain (自建方案不使用,占位)
VITE_PAYJS_DOMAIN=
# pay mchid
VITE_PAYJS_MCHID=
# pay sign key
VITE_PAYJS_SIGN_KEY=
# yun pay domain
VITE_YUNPAY_DOMAIN=
# yun pay mchid
VITE_YUNPAY_MCHID=
# yun pay sign key
VITE_YUNPAY_SIGN_KEY=
# z pay domain
VITE_ZPAY_DOMAIN=
# z pay mchid
VITE_ZPAY_MCHID=
# z pay sign key
VITE_ZPAY_SIGN_KEY=
# gtag id
VITE_GTAG_ID=
# upstream user (自己的 GitHub 账号)
VITE_UPSTREAM_USER=hsjer
# web branch
VITE_WEB_BRANCH=web
# dev branch
VITE_DEV_BRANCH=dev
# main branch
VITE_MAIN_BRANCH=main
# file limit size
VITE_FILE_LIMIT_SIZE=5
# file limit number
VITE_FILE_LIMIT_NUMBER=20
# local build version
VITE_LOCAL_RHEXE=
# pp api domain (自建方案不使用,留空)
VITE_PPAPI_DOMAIN=
